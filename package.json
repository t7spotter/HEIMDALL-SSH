{
  "name": "heimdall-ssh",
  "displayName": "Heimdall-SSH",
  "description": "Minimal live CPU, memory, load, disk and network stats for your SSH servers, right in the sidebar.",
  "version": "0.1.6",
  "publisher": "heimdall",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/t7spotter/HEIMDALL-SSH.git" },
  "homepage": "https://github.com/t7spotter/HEIMDALL-SSH",
  "bugs": { "url": "https://github.com/t7spotter/HEIMDALL-SSH/issues" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "heimdall", "title": "Heimdall-SSH", "icon": "media/icon.svg" }]
    },
    "views": {
      "heimdall": [{ "type": "webview", "id": "heimdall.servers", "name": "Servers" }]
    },
    "commands": [
      { "command": "heimdall.addServer", "title": "Heimdall-SSH: Add Server", "icon": "$(add)" },
      { "command": "heimdall.openSshConfig", "title": "Heimdall-SSH: Open ~/.ssh/config", "icon": "$(go-to-file)" },
      { "command": "heimdall.checkForUpdate", "title": "Heimdall-SSH: Check for Updates", "icon": "$(cloud-download)" },
      { "command": "heimdall.refresh", "title": "Heimdall-SSH: Reconnect All", "icon": "$(refresh)" },
      { "command": "heimdall.showHiddenHosts", "title": "Heimdall-SSH: Show Hidden Hosts" },
      { "command": "heimdall.forgetHostKeys", "title": "Heimdall-SSH: Forget Saved Host Keys" }
    ],
    "menus": {
      "view/title": [
        { "command": "heimdall.addServer", "when": "view == heimdall.servers", "group": "navigation@1" },
        { "command": "heimdall.openSshConfig", "when": "view == heimdall.servers", "group": "navigation@2" },
        { "command": "heimdall.refresh", "when": "view == heimdall.servers", "group": "navigation@3" },
        { "command": "heimdall.checkForUpdate", "when": "view == heimdall.servers", "group": "navigation@4" }
      ]
    },
    "configuration": {
      "title": "Heimdall-SSH",
      "properties": {
        "heimdall.refreshInterval": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Seconds between stat updates."
        },
        "heimdall.hiddenHosts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Host aliases from ~/.ssh/config to hide. Git hosts such as github.com and gitlab.com are always hidden."
        },
        "heimdall.servers": {
          "type": "array",
          "default": [],
          "description": "Extra servers to monitor (hosts in ~/.ssh/config are picked up automatically). Passwords are kept in VS Code's secret storage, never here.",
          "items": {
            "type": "object",
            "required": ["id", "name", "host", "username"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "host": { "type": "string" },
              "port": { "type": "number", "default": 22 },
              "username": { "type": "string" },
              "auth": { "enum": ["auto", "agent", "key", "password"], "default": "auto" },
              "keyPath": { "type": "string", "description": "Private key file (auth = key)." }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && node esbuild.js --production && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
